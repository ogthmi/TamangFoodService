<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="16dp">
    <!-- Food Image -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_food_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/OvalImage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:src="@drawable/ic_tamang_logo" />

    <!-- Food Name -->
    <TextView
        android:id="@+id/tv_food_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        tools:text="Strawberry ShakeuehjekgefnnnnnnnnShakeuehjekgefnnnnnnnnShakeuehjekgefnnnnnnnn"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_food_image"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Food Price -->
    <TextView
        android:id="@+id/tv_food_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="$20.00"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:layout_marginEnd="8dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/tv_food_name"
        app:layout_constraintStart_toStartOf="@id/tv_food_name"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_ingredients"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_food_name"
        app:layout_constraintTop_toBottomOf="@id/tv_food_price"
        tools:text="Cheese: $2&#10;Onion: $1" />

    <!-- Quantity Controls -->
    <LinearLayout
        android:id="@+id/ll_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="5dp"
        app:layout_constraintTop_toBottomOf="@id/tv_ingredients"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_decrease"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_minus_active"/>

        <TextView
            android:id="@+id/tv_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            tools:text="2"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageView
            android:id="@+id/iv_increase"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_plus_active" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/white"/>
</androidx.constraintlayout.widget.ConstraintLayout>

